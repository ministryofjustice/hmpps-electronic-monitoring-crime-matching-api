---
title: Crime Matching
---
erDiagram
    %% Domain
    crime 1 to 1+ crime_version : "has 1 or more versions"
    crime_version 1 to 0+ crime_matching_result : "has 0 or more matching results"
    crime_batch 1 to 1+ crime_version : "has 1 or more versions"

    %% Ingestion
    crime_batch_email_attachment 1 to zero or one crime_batch : "produces at most 1 crime batch"
    crime_batch_ingestion_attempt 1 to 1 crime_batch_email : "has 1 email"
    crime_batch_email 1 to 0+ crime_batch_email_attachment : "has 0 or more attachments"
    crime_batch_email_attachment 1 to zero or more crime_batch_email_attachment_ingestion_error : "has 0 or more ingestion errors"
    crime_batch_email 1 to 1 crime_batch_ingestion_error : "produces at most 1 crime batch ingestion error"
    crime_version 1 to 1+ crime_version_update : "has 1 or more version updates"

    %% Matching
    crime_batch 1 to 0+ crime_matching_run : "has 0 or more matching runs"
    crime_matching_run 1 to 1+ crime_matching_result : "produces 1 or more matching results"
    crime_matching_result 1 to 0+ crime_matching_result_device_wearer : "has 0 or more matched device wearers"
    crime_matching_result_device_wearer 1 to 1+ crime_matching_result_position : "has 2 or more positions"

    crime {
        uuid id PK
        varchar police_force_area UK "composite unique constraint"
        varchar crime_reference UK "composite unique constraint"
    }

    crime_batch {
        uuid id PK
        varchar batch_id
        uuid crime_batch_email_attachment_id FK, UK
        timestamp created_at
    }

    crime_batch_ingestion_attempt {
        uuid id PK
        varchar bucket
        varchar object_name
        timestamp created_at
    }

    crime_batch_email {
        uuid id PK
        uuid crime_batch_ingestion_attempt_id FK, UK
        varchar sender
        varchar original_sender
        varchar subject
        timestamp sent_at
    }

    crime_batch_email_attachment {
        uuid id PK
        uuid crime_batch_email_id FK, UK
        varchar file_name
        integer row_count
    }

    crime_batch_email_attachment_ingestion_error {
        uuid id PK
        uuid crime_batch_email_attachment_id FK
        bigint row_number
        varchar crime_reference
        varchar error_type
        varchar crime_type_id
        varchar field_name
        varchar value
    }

    crime_batch_ingestion_error {
        uuid id PK
        varchar error_type
        uuid crime_batch_ingestion_attempt_id FK, UK
    }

    crime_version {
        uuid id PK
        uuid crime_id FK
        uuid crime_batch_id FK
        varchar crime_type_id
        timestamptz crime_date_time_from
        timestamptz crime_date_time_to
        double easting
        double northing
        double latitude
        double longitude
        text crime_text
        timestamp created_at
    }

    crime_version_update {
        uuid id PK
        uuid crime_version_id FK
        varchar field_name
    }

    crime_matching_run {
        uuid id PK
        uuid crime_batch_id FK
        varchar algorithm_version
        varchar trigger_type
        varchar status
        timestamp created_at
        timestamp matching_started
        timestamp matching_ended
    }

    crime_matching_result {
        uuid id PK
        uuid crime_version_id FK, UK "composite unique constraint"
        uuid crime_matching_run_id FK, UK "composite unique constraint"
        timestamp created_at
    }

    crime_matching_result_device_wearer {
        uuid id PK
        uuid crime_matching_result_id FK, UK "composite unique constraint"
        varchar address
        timestamp date_of_birth "nullable"
        bigint device_id UK "composite unique constraint"
        varchar device_serial_number
        varchar device_name
        varchar identifier
        varchar name
        varchar nomis_id
        varchar pnc_ref
    }

    crime_matching_result_position {
        uuid id PK
        uuid crime_matching_result_device_wearer_id FK
        timestamptz captured_date_time
        bigint direction
        double latitude
        double longitude
        bigint precision
        varchar sequence_label
        bigint speed
        double entry_bearing "nullable"
        double exit_bearing "nullable"
    }