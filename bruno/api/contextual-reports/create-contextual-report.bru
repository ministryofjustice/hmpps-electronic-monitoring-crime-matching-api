meta {
  name: Create contextual report
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/matched-wearers/:deviceWearerId/contextual-reports
  body: json
  auth: bearer
}

params:path {
  deviceWearerId: 97921251-f722-4012-b4f2-c875cfc75917
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "startTime": "2025-08-17T12:00:00Z",
    "endTime": "2025-08-18T00:00:00Z",
    "policeForceArea": "Metropolitan",
    "officerName": "Test Officer",
    "requestedAt": "2026-11-06T11:00:00Z",
    "additionalInformation": "Contextual report request example",
    "hubManagerId": "a6aaaa8f-05c0-48d7-8371-2b367ad8b424"
  }
}

assert {
  res.status: eq 202
}
