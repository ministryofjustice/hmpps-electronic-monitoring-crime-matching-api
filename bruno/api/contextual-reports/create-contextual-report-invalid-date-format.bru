meta {
  name: Create contextual report (invalid date format)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/matched-wearers/48b83e4b-ea09-4ba7-8440-a7e5ed534cb4/contextual-reports
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "startTime": "not-a-date",
    "endTime": "2026-11-06T10:00:00Z",
    "policeForceArea": "Metropolitan Police",
    "officerName": "Test Officer",
    "requestedAt": "2026-11-06T11:00:00Z",
    "additionalInformation": "Invalid date format example",
    "hubManagerId": "a6aaaa8f-05c0-48d7-8371-2b367ad8b424"
  }
}

assert {
  res.status: eq 400
}
