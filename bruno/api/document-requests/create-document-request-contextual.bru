meta {
  name: Create document request (contextual)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/document-requests
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "type": "CONTEXTUAL_REPORT",
    "parameters": {
      "deviceId": 12345,
      "from": "2024-01-01T00:00:00Z",
      "to": "2024-01-01T11:59:59Z"
    }
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("documentRequestId", body.id);
}

assert {
  res.status: eq 202
  res.body: isObject
}
