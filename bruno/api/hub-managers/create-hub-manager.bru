meta {
  name: Create Hub Manager
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/hub-managers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Test Hub Manager",
    "occupation": "Test Occupation"
  }
}

assert {
  res.status: eq 201
  res.body: isObject
}

script:post-response {
  const body = res.getBody();
  bru.setVar("hubManagerId", body.data.id);
}
