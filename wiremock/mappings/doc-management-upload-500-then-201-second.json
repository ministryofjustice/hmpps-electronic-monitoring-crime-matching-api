{
  "scenarioName": "doc-management-upload-500-then-201",
  "requiredScenarioState": "succeeded-after-initial-failure",
  "request": {
    "method": "POST",
    "urlPathTemplate": "/documents/EMAC_REPORT/{documentId}"
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "documentUuid": "{{request.path.documentId}}",
      "documentFilename": "placeholder",
      "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
    },
    "transformers": ["response-template"]
  }
}
