{
  "name": "notify-send-email-500-then-201-second",
  "comment": "Second call in retry scenario: returns 201. Triggered when template_id is 00000000-0000-0000-0000-000000005051 (see application-local.yml for how to enable)",
  "priority": 1,
  "scenarioName": "notify-send-email-500-then-201",
  "requiredScenarioState": "succeeded-after-initial-failure",
  "request": {
    "method": "POST",
    "url": "/notify/v2/notifications/email",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.template_id[?(@ == '00000000-0000-0000-0000-000000005051')]"
      }
    ]
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "id": "11111111-1111-1111-1111-111111111111",
      "reference": null,
      "content": {
        "subject": "Test subject",
        "body": "Test body",
        "from_email": "test@example.com"
      },
      "uri": "http://localhost:8093/v2/notifications/11111111-1111-1111-1111-111111111111",
      "template": {
        "id": "22222222-2222-2222-2222-222222222222",
        "version": 1,
        "uri": "http://localhost:8093/v2/templates/22222222-2222-2222-2222-222222222222"
      }
    }
  }
}

