    "bodyPatterns": [
      {
        "matchesJsonPath": "$.template_id[?(@ == '00000000-0000-0000-0000-000000005051')]"
      }
    ]
  },
  "response": {
    "status": 500,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "errors": [
        {
          "error": "Exception",
          "message": "Internal server error"
        }
      ]
    }
  }
