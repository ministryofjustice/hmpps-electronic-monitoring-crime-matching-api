{
  "name": "notify-send-email-500",
  "comment": "Triggered when template_id is set to 00000000-0000-0000-0000-000000000500 (see application-local.yml for how to enable)",
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/notify/v2/notifications/email",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.template_id[?(@ == '00000000-0000-0000-0000-000000000500')]"
      }
    ]
  },
  "response": {
    "status": 500,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "errors": [
        {
          "error": "Exception",
          "message": "Internal server error"
        }
      ]
    }
  }
}

